{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mlm-web",
  "main": "./dist/web/server/server.mjs",
  "compatibility_date": "2026-07-24",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "./dist/web/browser"
  },
  "compatibility_flags": [
    "nodejs_compat"
  ]
}
